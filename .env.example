# ローカルでテスト実行する場合はこのファイルを .env にコピーして値を埋め、
# `export $(cat .env | xargs)` などで読み込んでから generate_article.py を実行してください。
# 本番運用ではこれらは GitHub の Secrets / Variables に設定します(.envはコミットしないこと)。

ANTHROPIC_API_KEY=sk-ant-xxxxx
CLAUDE_MODEL=claude-sonnet-5

# Amazonアソシエイト審査通過後に取得するトラッキングID(例: yourid-22)。未設定でも動作します。
AMAZON_ASSOC_TAG=

# 楽天アフィリエイト提携後に取得するID。未設定でも動作します。
RAKUTEN_AFFILIATE_ID=

SITE_URL=https://yourname.github.io/affiliate-lifehack-site
SITE_NAME=ひとり暮らし家電・便利グッズ比較ラボ

# X(Twitter) Developer Portalで発行するOAuth 1.0a User Contextの4点セット。
# 4つとも設定されている場合のみ、記事公開時に自動でツイートされる。未設定でも動作する。
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
